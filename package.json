{
  "name": "@polyweave/preston",
  "version": "1.1.1",
  "description": "A self-hosted chief of staff for your coding agents. Give it a goal. Get a result.",
  "license": "MIT",
  "author": "Polyweave",
  "homepage": "https://github.com/VolatileBit/preston#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VolatileBit/preston.git"
  },
  "bugs": {
    "url": "https://github.com/VolatileBit/preston/issues"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "orchestrator",
    "chief-of-staff",
    "discord",
    "slack",
    "self-hosted"
  ],
  "type": "module",
  "bin": {
    "preston": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "vitest run -c vitest.smoke.config.ts",
    "test:pack": "npm run build && node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/bolt": "^5.1.0",
    "discord.js": "^14.28.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
